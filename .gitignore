# dependencies
node_modules/
.vscode/
.idea/
*.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

#env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# backend
backend/dist/
backend/node_modules/

**/coverage

